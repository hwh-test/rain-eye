  .btn-re:hover, .btn-re:focus { background: var(--re-blue-dark); border-color: var(--re-blue-dark); color: #fff; }
  .re-auth-card { max-width: 420px; margin: 0 auto; }
  .re-demo-note { font-size: .8rem; color: #6c757d; }
